{
  "name": "bigfish",
  "version": "0.1.2",
  "description": "Bigfish — Electron desktop shell for DeepSeek Harness",
  "private": true,
  "main": "main.js",
  "author": {
    "name": "Bigfish",
    "email": "643820309@qq.com"
  },
  "homepage": "https://github.com/turtle2209/Bigfish",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "icons": "node make-icons.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bigfish.app",
    "productName": "Bigfish",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "afterPack": "afterPack.js",
    "files": [
      "main.js",
      "welcome.html",
      "welcome.js",
      "welcome-preload.js",
      "pet.html",
      "pet.js",
      "pet-preload.js",
      "market.html",
      "market.js",
      "market-preload.js",
      "exchange.html",
      "exchange.js",
      "exchange-preload.js",
      "plugins.json",
      "bundled-skills/**/*",
      "assets/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "THIRD-PARTY-NOTICES.md",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "node-runtime",
        "to": "node-runtime"
      },
      {
        "from": "bundled-plugins",
        "to": "bundled-plugins"
      },
      {
        "from": "dsh-bundle/node_modules",
        "to": "dsh/node_modules"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "shortcutName": "Bigfish"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
